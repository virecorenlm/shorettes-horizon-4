{% doc %}
  Emits the Shorette's brand design tokens as CSS custom properties.

  Every value is sourced from theme settings (Theme settings > Shorette's brand) so the
  palette stays editable in the theme editor. Falls back to the brand defaults when a
  setting has never been saved.

  Consumed by `assets/shorettes-brand.css` and every `sections/shorettes-*.liquid` section.
{% enddoc %}

{% liquid
  assign navy = settings.shorettes_color_navy | default: '#0B171D'
  assign blue = settings.shorettes_color_blue | default: '#176B87'
  assign bone = settings.shorettes_color_bone | default: '#F4F1E8'
  assign orange = settings.shorettes_color_orange | default: '#F05A28'
  assign slate = settings.shorettes_color_slate | default: '#66747A'
%}

{%- capture navy_rgb -%}
  {{ navy | color_extract: 'red' }} {{ navy | color_extract: 'green' }} {{ navy | color_extract: 'blue' }}
{%- endcapture -%}
{%- capture blue_rgb -%}
  {{ blue | color_extract: 'red' }} {{ blue | color_extract: 'green' }} {{ blue | color_extract: 'blue' }}
{%- endcapture -%}
{%- capture bone_rgb -%}
  {{ bone | color_extract: 'red' }} {{ bone | color_extract: 'green' }} {{ bone | color_extract: 'blue' }}
{%- endcapture -%}
{%- capture orange_rgb -%}
  {{ orange | color_extract: 'red' }} {{ orange | color_extract: 'green' }} {{ orange | color_extract: 'blue' }}
{%- endcapture -%}
{%- capture slate_rgb -%}
  {{ slate | color_extract: 'red' }} {{ slate | color_extract: 'green' }} {{ slate | color_extract: 'blue' }}
{%- endcapture -%}

{% style %}
  :root {
    /* ---- Brand palette ---- */
    --shorettes-navy: {{ navy }};
    --shorettes-navy-rgb: {{ navy_rgb | strip }};
    --shorettes-blue: {{ blue }};
    --shorettes-blue-rgb: {{ blue_rgb | strip }};
    --shorettes-bone: {{ bone }};
    --shorettes-bone-rgb: {{ bone_rgb | strip }};
    --shorettes-orange: {{ orange }};
    --shorettes-orange-rgb: {{ orange_rgb | strip }};
    --shorettes-slate: {{ slate }};
    --shorettes-slate-rgb: {{ slate_rgb | strip }};

    /* ---- Derived surfaces ---- */
    --shorettes-navy-deep: {{ navy | color_darken: 3 }};
    --shorettes-navy-raised: {{ navy | color_lighten: 6 }};
    --shorettes-blue-dark: {{ blue | color_darken: 8 }};
    --shorettes-orange-hover: {{ orange | color_darken: 8 }};
    --shorettes-bone-shade: {{ bone | color_darken: 3 }};

    /* ---- Lines and separators ---- */
    --shorettes-hairline: rgb(var(--shorettes-navy-rgb) / 0.12);
    --shorettes-hairline-strong: rgb(var(--shorettes-navy-rgb) / 0.2);
    --shorettes-hairline-inverse: rgb(var(--shorettes-bone-rgb) / 0.16);

    /* ---- Elevation ---- */
    --shorettes-shadow-sm: 0 1px 2px rgb(var(--shorettes-navy-rgb) / 0.08);
    --shorettes-shadow-md: 0 6px 20px rgb(var(--shorettes-navy-rgb) / 0.1);
    --shorettes-shadow-lg: 0 18px 48px rgb(var(--shorettes-navy-rgb) / 0.22);

    /* ---- Radii ---- */
    --shorettes-radius-xs: 2px;
    --shorettes-radius-sm: 4px;
    --shorettes-radius-md: 6px;

    /* ---- Spacing scale ---- */
    --shorettes-space-3xs: 0.25rem;
    --shorettes-space-2xs: 0.5rem;
    --shorettes-space-xs: 0.75rem;
    --shorettes-space-sm: 1rem;
    --shorettes-space-md: 1.5rem;
    --shorettes-space-lg: 2rem;
    --shorettes-space-xl: 3rem;
    --shorettes-space-2xl: 4rem;

    /* ---- Layout ---- */
    --shorettes-content-width: 90rem;
    --shorettes-gutter: 1.25rem;

    /* ---- Typography ---- */
    --shorettes-display-family: var(--font-heading--family);
    --shorettes-display-weight: 700;
    --shorettes-display-tracking: 0.005em;
    --shorettes-eyebrow-tracking: 0.14em;
    --shorettes-ui-family: var(--font-body--family);

    /* ---- Motion ---- */
    --shorettes-transition: 180ms cubic-bezier(0.33, 1, 0.68, 1);
  }

  @media screen and (min-width: 750px) {
    :root {
      --shorettes-gutter: 2rem;
    }
  }

  @media screen and (min-width: 1280px) {
    :root {
      --shorettes-gutter: 2.5rem;
    }
  }
{% endstyle %}
