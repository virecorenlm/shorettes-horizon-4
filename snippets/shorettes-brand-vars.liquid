{% doc %}
  Emits the Shorette's brand design tokens as CSS custom properties.

  Palette is black / charcoal / red / white. The red default is sampled from the
  Shorette's muskie crest artwork so the interface and the logo agree.

  Every value is sourced from theme settings (Theme settings > Shorette's brand) so the
  palette stays editable in the theme editor. Falls back to the brand defaults when a
  setting has never been saved.

  Consumed by `assets/shorettes-brand.css` and every `sections/shorettes-*.liquid` section.
{% enddoc %}

{% liquid
  assign ink = settings.shorettes_color_ink | default: '#0A0A0A'
  assign charcoal = settings.shorettes_color_charcoal | default: '#17191A'
  assign paper = settings.shorettes_color_paper | default: '#FFFFFF'
  assign red = settings.shorettes_color_red | default: '#D21404'
  assign slate = settings.shorettes_color_slate | default: '#6B7378'
%}

{%- capture ink_rgb -%}
  {{ ink | color_extract: 'red' }} {{ ink | color_extract: 'green' }} {{ ink | color_extract: 'blue' }}
{%- endcapture -%}
{%- capture charcoal_rgb -%}
  {{ charcoal | color_extract: 'red' }} {{ charcoal | color_extract: 'green' }} {{ charcoal | color_extract: 'blue' }}
{%- endcapture -%}
{%- capture paper_rgb -%}
  {{ paper | color_extract: 'red' }} {{ paper | color_extract: 'green' }} {{ paper | color_extract: 'blue' }}
{%- endcapture -%}
{%- capture red_rgb -%}
  {{ red | color_extract: 'red' }} {{ red | color_extract: 'green' }} {{ red | color_extract: 'blue' }}
{%- endcapture -%}
{%- capture slate_rgb -%}
  {{ slate | color_extract: 'red' }} {{ slate | color_extract: 'green' }} {{ slate | color_extract: 'blue' }}
{%- endcapture -%}

{% style %}
  :root {
    /* ---- Brand palette ---- */
    --shorettes-ink: {{ ink }};
    --shorettes-ink-rgb: {{ ink_rgb | strip }};
    --shorettes-charcoal: {{ charcoal }};
    --shorettes-charcoal-rgb: {{ charcoal_rgb | strip }};
    --shorettes-paper: {{ paper }};
    --shorettes-paper-rgb: {{ paper_rgb | strip }};
    --shorettes-red: {{ red }};
    --shorettes-red-rgb: {{ red_rgb | strip }};
    --shorettes-slate: {{ slate }};
    --shorettes-slate-rgb: {{ slate_rgb | strip }};

    /* ---- Derived surfaces ---- */
    --shorettes-ink-deep: {{ ink | color_darken: 2 }};
    --shorettes-ink-raised: {{ ink | color_lighten: 8 }};
    --shorettes-charcoal-dark: {{ charcoal | color_darken: 5 }};
    --shorettes-red-hover: {{ red | color_darken: 8 }};
    --shorettes-paper-shade: {{ paper | color_darken: 4 }};

    /* ---- Lines and separators ---- */
    --shorettes-hairline: rgb(var(--shorettes-ink-rgb) / 0.12);
    --shorettes-hairline-strong: rgb(var(--shorettes-ink-rgb) / 0.2);
    --shorettes-hairline-inverse: rgb(var(--shorettes-paper-rgb) / 0.16);

    /* ---- Elevation ---- */
    --shorettes-shadow-sm: 0 1px 2px rgb(var(--shorettes-ink-rgb) / 0.08);
    --shorettes-shadow-md: 0 6px 20px rgb(var(--shorettes-ink-rgb) / 0.12);
    --shorettes-shadow-lg: 0 18px 48px rgb(var(--shorettes-ink-rgb) / 0.28);

    /* ---- Radii ---- */
    --shorettes-radius-xs: 2px;
    --shorettes-radius-sm: 4px;
    --shorettes-radius-md: 6px;

    /* ---- Spacing scale ---- */
    --shorettes-space-3xs: 0.25rem;
    --shorettes-space-2xs: 0.5rem;
    --shorettes-space-xs: 0.75rem;
    --shorettes-space-sm: 1rem;
    --shorettes-space-md: 1.5rem;
    --shorettes-space-lg: 2rem;
    --shorettes-space-xl: 3rem;
    --shorettes-space-2xl: 4rem;

    /* ---- Layout ---- */
    --shorettes-content-width: 90rem;
    --shorettes-gutter: 1.25rem;

    /* ---- Typography ---- */
    --shorettes-display-family: var(--font-heading--family);
    --shorettes-display-weight: 700;
    --shorettes-display-tracking: 0.005em;
    --shorettes-eyebrow-tracking: 0.14em;
    --shorettes-ui-family: var(--font-body--family);

    /* ---- Motion ---- */
    --shorettes-transition: 180ms cubic-bezier(0.33, 1, 0.68, 1);
  }

  @media screen and (min-width: 750px) {
    :root {
      --shorettes-gutter: 2rem;
    }
  }

  @media screen and (min-width: 1280px) {
    :root {
      --shorettes-gutter: 2.5rem;
    }
  }
{% endstyle %}
