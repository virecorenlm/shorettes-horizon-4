{% doc %}
  Renders one of the Shorette's brand icons as a complete inline SVG.

  These are original silhouettes drawn for this theme. Fish icons use a wide 128x64
  viewBox, utility icons a square 64x64 one, so the wrapper element controls size via
  CSS (`width`/`height`) rather than fixed attributes.

  Distinct from `snippets/icon.liquid`, which emits bare `<path>` data for Horizon's
  square 20x20 icon set and has no species, tackle, or trust icons.

  @param {string} icon - Icon name. Species: musky, pike, bass, walleye, panfish, trout.
    Category: lures, rods-reels, terminal-tackle, marine, apparel, kids, nets.
    Trust/utility: shipping, secure, angler, support, phone, pin.
  @param {string} [class] - Extra class names for the root `<svg>`.

  @example
  {% render 'shorettes-icon', icon: 'musky', class: 'shorettes-species__icon' %}
{% enddoc %}

{%- liquid
  assign fish_icons = 'musky,pike,bass,walleye,panfish,trout,angler' | split: ','
  assign view_box = '0 0 64 64'
  if fish_icons contains icon
    assign view_box = '0 0 128 64'
  endif
  assign svg_class = 'shorettes-icon'
  if class != blank
    assign svg_class = svg_class | append: ' ' | append: class
  endif
-%}

<svg
  class="{{ svg_class }}"
  viewBox="{{ view_box }}"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  {%- case icon -%}
    {%- when 'musky' -%}
      <path
        fill="currentColor"
        fill-rule="evenodd"
        d="M4 33C13 25.5 27 20.5 47 18.6C69 16.5 90 19.6 105 26L120 14L115.5 33L120 52L105 40C90 46.4 69 49.5 47 47.4C27 45.5 13 40.5 4 33ZM17.5 30a2.6 2.6 0 1 0 5.2 0 2.6 2.6 0 1 0-5.2 0Z"
      />
      <path fill="currentColor" d="M82 21.5 92 6l8 17.5ZM80 44.5 90 59l8-15.5ZM40 43l7 11 9-9.5Z" />
    {%- when 'pike' -%}
      <path
