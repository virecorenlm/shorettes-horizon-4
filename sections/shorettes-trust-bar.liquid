{%- liquid
  assign items = section.blocks | where: 'type', 'item'
-%}

{%- if items.size > 0 -%}
  <div
    class="shorettes-trust"
    style="
      --shorettes-trust-background: {{ section.settings.background_color | default: '#0B171D' }};
      --shorettes-trust-text: {{ section.settings.text_color | default: '#F4F1E8' }};
      --shorettes-trust-padding-start: {{ section.settings['padding-block-start'] | default: 32 }}px;
      --shorettes-trust-padding-end: {{ section.settings['padding-block-end'] | default: 32 }}px;
    "
    {{ section.shopify_attributes }}
  >
    <div class="shorettes-container">
      {%- if section.settings.heading != blank -%}
        <h2 class="shorettes-eyebrow shorettes-trust__title">{{ section.settings.heading }}</h2>
      {%- endif -%}

      <ul class="shorettes-trust__list" role="list">
        {%- for block in items -%}
          <li class="shorettes-trust__item" {{ block.shopify_attributes }}>
            <span class="shorettes-trust__icon">
              {%- render 'shorettes-icon', icon: block.settings.icon -%}
            </span>
            <span class="shorettes-trust__body">
              {%- if block.settings.heading != blank -%}
                <span class="shorettes-trust__heading">{{ block.settings.heading }}</span>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <span class="shorettes-trust__text">{{ block.settings.text }}</span>
              {%- endif -%}
            </span>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .shorettes-trust {
    padding-block: var(--shorettes-trust-padding-start) var(--shorettes-trust-padding-end);
    background-color: var(--shorettes-trust-background);
    color: var(--shorettes-trust-text);
  }

  .shorettes-trust__title {
    margin-block-end: var(--shorettes-space-sm);
    opacity: 0.7;
  }

  .shorettes-trust__list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--shorettes-space-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .shorettes-trust__item {
    display: flex;
    align-items: center;
    gap: var(--shorettes-space-xs);
    min-width: 0;
  }

  .shorettes-trust__icon {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    color: var(--shorettes-trust-text);
  }

  .shorettes-trust__body {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  .shorettes-trust__heading {
    font-family: var(--shorettes-display-family);
    font-size: 0.9375rem;
    font-weight: var(--shorettes-display-weight);
    letter-spacing: 0.03em;
    line-height: 1.15;
    text-transform: uppercase;
  }

  .shorettes-trust__text {
    font-family: var(--shorettes-ui-family);
    font-size: 0.8125rem;
    line-height: 1.4;
    opacity: 0.78;
    text-wrap: pretty;
  }

  @media screen and (min-width: 750px) {
    .shorettes-trust__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--shorettes-space-lg);
    }
  }

  @media screen and (min-width: 1100px) {
    .shorettes-trust__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Shorette's trust bar",
  "tag": "section",
  "class": "shorettes-trust-wrapper",
  "disabled_on": {
    "groups": ["header"]
  },
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Optional. Leave blank to show only the four items."
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#0B171D"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#F4F1E8"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shipping", "label": "Shipping" },
            { "value": "secure", "label": "Secure" },
            { "value": "angler", "label": "Angler" },
            { "value": "support", "label": "Support" },
            { "value": "pin", "label": "Location" },
            { "value": "phone", "label": "Phone" }
          ],
          "default": "shipping"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Fast shipping"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Orders ship same or next business day."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shorette's trust bar",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "icon": "shipping",
            "heading": "Fast shipping",
            "text": "Orders ship same or next business day."
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "secure",
            "heading": "Secure checkout",
            "text": "Safe & secure shopping experience."
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "angler",
            "heading": "Angler owned",
            "text": "We fish it, so we sell it."
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "support",
            "heading": "Real customer support",
            "text": "Local help from people who care."
          }
        }
      ]
    }
  ]
}
{% endschema %}
