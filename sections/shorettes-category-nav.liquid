{%- liquid
  assign species_blocks = section.blocks | where: 'type', 'species'
  assign category_blocks = section.blocks | where: 'type', 'category'
-%}

<div
  class="shorettes-catnav"
  style="
    --shorettes-catnav-background: {{ section.settings.background_color | default: '#FFFFFF' }};
    --shorettes-catnav-text: {{ section.settings.text_color | default: '#0B171D' }};
    --shorettes-catnav-padding-start: {{ section.settings['padding-block-start'] | default: 32 }}px;
    --shorettes-catnav-padding-end: {{ section.settings['padding-block-end'] | default: 32 }}px;
  "
  {{ section.shopify_attributes }}
>
  <div class="shorettes-container shorettes-catnav__inner">
    {%- if species_blocks.size > 0 -%}
      <section class="shorettes-catnav__group">
        {%- if section.settings.species_heading != blank -%}
          <h2 class="shorettes-eyebrow shorettes-catnav__title">{{ section.settings.species_heading }}</h2>
        {%- endif -%}
        <ul class="shorettes-catnav__list" role="list">
          {%- for block in species_blocks -%}
            <li class="shorettes-catnav__item" {{ block.shopify_attributes }}>
              {%- if block.settings.link != blank -%}
                <a class="shorettes-catnav__link" href="{{ block.settings.link }}">
                  {%- render 'shorettes-catnav-item', block: block, fallback_icon: 'bass' -%}
                </a>
              {%- else -%}
                <span class="shorettes-catnav__link shorettes-catnav__link--static">
                  {%- render 'shorettes-catnav-item', block: block, fallback_icon: 'bass' -%}
                </span>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </section>
    {%- endif -%}

    {%- if category_blocks.size > 0 -%}
      <section class="shorettes-catnav__group shorettes-catnav__group--category">
        {%- if section.settings.category_heading != blank -%}
          <h2 class="shorettes-eyebrow shorettes-catnav__title">{{ section.settings.category_heading }}</h2>
        {%- endif -%}
        <ul class="shorettes-catnav__list" role="list">
          {%- for block in category_blocks -%}
            <li class="shorettes-catnav__item" {{ block.shopify_attributes }}>
              {%- if block.settings.link != blank -%}
                <a class="shorettes-catnav__link" href="{{ block.settings.link }}">
                  {%- render 'shorettes-catnav-item', block: block, fallback_icon: 'lures' -%}
                </a>
              {%- else -%}
                <span class="shorettes-catnav__link shorettes-catnav__link--static">
                  {%- render 'shorettes-catnav-item', block: block, fallback_icon: 'lures' -%}
                </span>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </section>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .shorettes-catnav {
    padding-block: var(--shorettes-catnav-padding-start) var(--shorettes-catnav-padding-end);
    background-color: var(--shorettes-catnav-background);
    color: var(--shorettes-catnav-text);
  }

  .shorettes-catnav__inner {
    display: grid;
    gap: var(--shorettes-space-lg);
  }

  .shorettes-catnav__group {
    display: grid;
    gap: var(--shorettes-space-sm);
    min-width: 0;
  }

  .shorettes-catnav__title {
    color: rgb(var(--shorettes-navy-rgb) / 0.62);
  }

  .shorettes-catnav__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--shorettes-space-sm) var(--shorettes-space-2xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .shorettes-catnav__link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--shorettes-space-2xs);
    padding: var(--shorettes-space-2xs);
    color: inherit;
    text-decoration: none;
    border-radius: var(--shorettes-radius-xs);
    transition: color var(--shorettes-transition), background-color var(--shorettes-transition);
  }

  a.shorettes-catnav__link:hover {
    color: var(--shorettes-orange);
    background-color: rgb(var(--shorettes-navy-rgb) / 0.04);
  }

  a.shorettes-catnav__link:focus-visible {
    outline: 3px solid var(--shorettes-orange);
    outline-offset: 2px;
  }

  .shorettes-catnav__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 2.5rem;
  }

  .shorettes-catnav__icon .shorettes-icon {
    width: auto;
    max-width: 100%;
    height: 100%;
  }

  .shorettes-catnav__icon img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .shorettes-catnav__label {
    font-family: var(--shorettes-ui-family);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1.2;
    text-align: center;
    text-transform: uppercase;
    text-wrap: balance;
  }

  @media screen and (min-width: 750px) {
    .shorettes-catnav__list {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    .shorettes-catnav__icon {
      height: 3rem;
    }

    .shorettes-catnav__label {
      font-size: 0.75rem;
    }
  }

  @media screen and (min-width: 1100px) {
    .shorettes-catnav__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--shorettes-space-xl);
      align-items: start;
    }

    .shorettes-catnav__group--category {
      padding-inline-start: var(--shorettes-space-xl);
      border-inline-start: 1px solid var(--shorettes-hairline);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Shorette's category nav",
  "tag": "section",
  "class": "shorettes-catnav-wrapper",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 16,
  "settings": [
    {
      "type": "paragraph",
      "content": "Blocks without a link still show, but are not clickable. Leave a link empty until the matching collection exists."
    },
    {
      "type": "text",
      "id": "species_heading",
      "label": "Species heading",
      "default": "Shop by species"
    },
    {
      "type": "text",
      "id": "category_heading",
      "label": "Category heading",
      "default": "Shop by category"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#0B171D"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "species",
      "name": "Species",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "musky", "label": "Musky" },
            { "value": "pike", "label": "Pike" },
            { "value": "bass", "label": "Bass" },
            { "value": "walleye", "label": "Walleye" },
            { "value": "panfish", "label": "Panfish" },
            { "value": "trout", "label": "Trout" }
          ],
          "default": "bass"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Optional. Replaces the icon."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Bass"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    },
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "lures", "label": "Lures" },
            { "value": "rods-reels", "label": "Rods & reels" },
            { "value": "terminal-tackle", "label": "Terminal tackle" },
            { "value": "marine", "label": "Marine" },
            { "value": "nets", "label": "Nets" },
            { "value": "apparel", "label": "Apparel" },
            { "value": "kids", "label": "Kids" }
          ],
          "default": "lures"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Optional. Replaces the icon."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Lures"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shorette's category nav",
      "blocks": [
        { "type": "species", "settings": { "icon": "musky", "label": "Musky" } },
        { "type": "species", "settings": { "icon": "bass", "label": "Bass" } },
        { "type": "species", "settings": { "icon": "walleye", "label": "Walleye" } },
        { "type": "species", "settings": { "icon": "pike", "label": "Pike" } },
        { "type": "species", "settings": { "icon": "panfish", "label": "Panfish" } },
        { "type": "species", "settings": { "icon": "trout", "label": "Trout" } },
        { "type": "category", "settings": { "icon": "lures", "label": "Lures" } },
        { "type": "category", "settings": { "icon": "rods-reels", "label": "Rods & reels" } },
        { "type": "category", "settings": { "icon": "terminal-tackle", "label": "Terminal tackle" } },
        { "type": "category", "settings": { "icon": "marine", "label": "Marine" } },
        { "type": "category", "settings": { "icon": "apparel", "label": "Apparel" } },
        { "type": "category", "settings": { "icon": "kids", "label": "Kids" } }
      ]
    }
  ]
}
{% endschema %}
