

{%- liquid
  assign is_row = false
  if section.settings.announcement_layout == 'row'
    assign is_row = true
  endif
-%}

{% if section.blocks.size > 1 and is_row == false %}
  <script
    src="{{ 'announcement-bar.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% endif %}

{% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}

<div class="section-background color-custom-{{ section.id }}"></div>
<aside
  class="announcement-bar spacing-style section section--{{ section.settings.section_width }} color-custom-{{ section.id }}"
  style="{% render 'spacing-padding', settings: section.settings %}; --border-bottom-width: {{ section.settings.divider_width }}px;{% if section.settings.divider_color != blank %} --color-border: {{ section.settings.divider_color }};{% endif %}"
>
  {% liquid
    assign autoplay = false
    assign show_arrows = false
    if section.blocks.size > 1 and is_row == false
      assign autoplay = true
      assign show_arrows = true
    endif
  %}

  {% capture contact_markup %}
    {% if section.settings.contact_text != blank %}
      {% if section.settings.contact_link != blank %}
        <a
          class="shorettes-announcement-contact"
          href="{{ section.settings.contact_link | escape }}"
        >
          {% render 'shorettes-icon', icon: 'phone', class: 'shorettes-announcement-contact__icon' %}
          <span>{{ section.settings.contact_text }}</span>
        </a>
      {% else %}
        <span class="shorettes-announcement-contact">
          {% render 'shorettes-icon', icon: 'phone', class: 'shorettes-announcement-contact__icon' %}
          <span>{{ section.settings.contact_text }}</span>
        </span>
      {% endif %}
    {% endif %}
  {% endcapture %}

  {%- comment -%}
    Shopify permits exactly one block-rendering tag per section and enforces that
    statically, so the row and carousel layouts cannot each render their own copy.
    The blocks are rendered once below and the two layouts are purely a CSS
    difference, switched by the `--row` modifier.

    In row mode `announcement-bar.js` is not loaded, so `<announcement-bar-component>`
    stays an inert unknown element and the autoplay attribute is omitted.
  {%- endcomment -%}
  <announcement-bar-component
    class="announcement-bar__slider{% if is_row %} announcement-bar__slider--row shorettes-announcement-row{% endif %}"
    {% if autoplay == true %}
      autoplay="{{ section.settings.speed }}" aria-live="polite"
    {% endif %}
  >
    {% if show_arrows %}
      {% render 'slideshow-arrows', icon_style: 'chevron' %}
    {% endif %}

    <div class="announcement-bar__slides{% if is_row %} shorettes-announcement-row__messages{% endif %}">
      {% content_for 'blocks' %}
    </div>

    {{ contact_markup }}
  </announcement-bar-component>
</aside>

{% stylesheet %}
  .announcement-bar {
    border-block-end: var(--border-bottom-width) solid var(--color-border);
  }

  .announcement-bar__slider {
    display: flex;
    flex-direction: row;
    align-items: center;
    position: relative;

    @media screen and (max-width: 749px) {
      grid-column: 1 / -1;
    }
  }

  .announcement-bar__slides {
    display: grid;
    grid: [stack] auto / [stack] auto;
    width: calc(100% - var(--button-size) * 2);
    max-width: 680px;
    margin-inline: auto;
  }

  .announcement-bar__slides > * {
    grid-area: stack;
  }

  .announcement-bar__slide {
    transition: opacity 0.5s ease-in-out, visibility 0.5s ease-in-out;
    content-visibility: visible;

    &[aria-hidden='true'] {
      opacity: 0;
      visibility: hidden;
    }
  }

  .announcement-bar__slider slideshow-arrows {
    padding: 0;
    mix-blend-mode: normal;
  }

  .announcement-bar__slider slideshow-arrows .slideshow-control {
    color: var(--color-foreground);
  }

  .announcement-bar__slider .slideshow-control {
    display: flex;
    padding: 0;
    width: var(--button-size);
    height: var(--button-size);
    align-items: center;
    justify-content: center;
    opacity: 1;
    animation: none;

    @media screen and (min-width: 750px) {
      --slideshow-control-offset: calc((var(--button-size) - var(--icon-size-xs)) / 2);

      .section--page-width &.slideshow-control--previous {
        transform: translateX(var(--slideshow-control-offset));
      }
    }
  }

  .announcement-bar__slider .slideshow-control .svg-wrapper {
    width: var(--icon-size-xs);
    height: var(--icon-size-xs);
  }

  .announcement-bar__slide {
    place-content: center;
  }

  .announcement-bar__text:first-child {
    margin: 0;
  }

  .announcement-bar__link {
    position: absolute;
    inset: 0;
  }

  /* ---- Row layout ---- */

  /* Same markup as the carousel, so every rule here has to undo a carousel rule.
     The two-class selectors outrank the single-class defaults above. */
  .announcement-bar__slider--row {
    grid-column: 1 / -1;
    width: 100%;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--shorettes-space-2xs, 0.5rem) var(--shorettes-space-md, 1.5rem);
  }

  /* Undo the stacked grid: announcements sit side by side. */
  .announcement-bar__slider--row .announcement-bar__slides {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--shorettes-space-2xs, 0.5rem) var(--shorettes-space-md, 1.5rem);
    width: auto;
    max-width: none;
    margin-inline: 0;
  }

  .announcement-bar__slider--row .announcement-bar__slides > * {
    grid-area: auto;
  }

  /* Undo the fade-out, and the block default of `width: var(--width, 100%)`
     which would otherwise stack them. */
  .announcement-bar__slider--row .announcement-bar__slide {
    position: relative;
    flex: none;
    width: auto;
    opacity: 1;
    visibility: visible;
    transition: none;
  }

  .announcement-bar__slider--row .announcement-bar__text {
    width: auto;
  }

  /* Keep the contact detail on the same line as the slider when both are shown. */
  .announcement-bar:has(.shorettes-announcement-contact) {
    align-items: center;
  }

  @media screen and (min-width: 990px) {
    .announcement-bar__slider--row {
      flex-wrap: nowrap;
      justify-content: space-between;
    }
  }

  @media screen and (max-width: 749px) {
    .announcement-bar__slider--row .announcement-bar__slide:nth-child(n + 3) {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.announcement_bar",
  "blocks": [
    {
      "type": "_announcement"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "select",
      "id": "announcement_layout",
      "label": "Layout",
      "info": "Row shows every announcement side by side on desktop. Rotating fades between them.",
      "options": [
        {
          "value": "carousel",
          "label": "Rotating"
        },
        {
          "value": "row",
          "label": "Row"
        }
      ],
      "default": "carousel"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "t:settings.scroll_speed",
      "min": 2,
      "max": 10,
      "default": 5,
      "unit": "sec",
      "visible_if": "{{ section.settings.announcement_layout != 'row' }}"
    },
    {
      "type": "header",
      "content": "Contact"
    },
    {
      "type": "text",
      "id": "contact_text",
      "label": "Contact text",
      "info": "Shown at the end of the bar. Leave blank to hide."
    },
    {
      "type": "text",
      "id": "contact_link",
      "label": "Contact link",
      "info": "A full URL, or tel:+13156497387 to make the number tappable. Leave blank for plain text.",
      "visible_if": "{{ section.settings.contact_text != blank }}"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "range",
      "id": "divider_width",
      "label": "t:settings.divider_thickness",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "t:settings.divider_color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ section.settings.divider_width > 0 }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "t:names.announcement_bar",
      "blocks": {
        "announcement_1": {
          "type": "_announcement"
        }
      },
      "block_order": ["announcement_1"]
    }
  ]
}
{% endschema %}
